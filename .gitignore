node_modules/
dist/
*.log

# per-worktree builder briefs — never shared, and they collide at merge
BRIEF*.md
node_modules/
node_modules

# THE LIVE QUEUE IS COORDINATION STATE, NOT SOURCE — see scripts/claim.sh.
# Tracked, it was clobbered by ordinary git: the desk stashed it around a merge
# and a builder's DONE row, written inside that window, was restored away. The
# builder caught it by chance. Untracked, no checkout/stash/merge can touch it,
# and it is still shared by every worktree because the scripts resolve it via
# `git rev-parse --git-common-dir`. Completed rows are archived to
# notes/archive/QUEUE-done-*.md, which IS tracked — that is where the history
# lives.
street/notes/QUEUE.md

# Staging copy of the packed artifact, taken out of dist/ so it survives a
# worktree cleanup long enough to publish. A build product, not source.
street/artifact/
street/notes/.queue-history/

# The local SQLite save database (server/db.mjs). It is what you get when
# DATABASE_URL is unset — a dev convenience, never a source of truth, and it
# holds whatever outfit you happened to be wearing when you last pressed a key.
server/*.db
server/*.db-shm
server/*.db-wal
