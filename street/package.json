{
  "name": "street",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177",
    "live": "TUNNEL=1 vite --port 5177 --host",
    "build": "node scripts/check-wiring.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4177",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sweep": "node scripts/bugsweep.mjs",
    "fp": "node scripts/scenedump.mjs",
    "fpdiff": "node scripts/fpdiff.mjs",
    "capture": "node scripts/capture.mjs",
    "wiring": "node scripts/check-wiring.mjs -v"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
