{
  "name": "street",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "guard": "node scripts/guard-shared-checkout.mjs",
    "preinstall": "node scripts/guard-shared-checkout.mjs 'npm install'",
    "dev": "npm run guard --silent -- 'npm run dev' && vite --port 5177",
    "live": "npm run guard --silent -- 'npm run live' && TUNNEL=1 vite --port 5177 --host",
    "build": "npm run guard --silent -- 'npm run build' && tsc --noEmit && vite build",
    "preview": "vite preview --port 4177",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sweep": "node scripts/bugsweep.mjs",
    "fp": "node scripts/scenedump.mjs",
    "fpdiff": "node scripts/fpdiff.mjs",
    "capture": "node scripts/capture.mjs",
    "wiring": "node scripts/check-wiring.mjs -v",
    "checks": "node scripts/checks.mjs",
    "walk": "node scripts/D-walk.mjs",
    "stepoff": "node scripts/stepoff-walk.mjs",
    "artifact": "node scripts/pack-artifact.mjs && node scripts/check-artifact.mjs",
    "ledger": "node scripts/ledger-intact.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
